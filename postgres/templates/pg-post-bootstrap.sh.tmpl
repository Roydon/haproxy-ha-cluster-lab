#!/usr/bin/env bash
# Patroni's bootstrap.post_bootstrap hook: invoked as `pg-post-bootstrap.sh <connstring>`
# with a stripped environment (no app-user vars), so this file is itself rendered from
# a template at container start (see entrypoint.sh) with the app user/db baked in.
# Runs *before* bootstrap.users are applied, so the app role is created here.
set -euo pipefail
CONNSTRING="$1"

ROLE_EXISTS=$(psql "$CONNSTRING" -tAc "SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = '${POSTGRES_APP_USER}'")
if [ "$ROLE_EXISTS" != "1" ]; then
  psql "$CONNSTRING" -v ON_ERROR_STOP=1 -c \
    "CREATE ROLE ${POSTGRES_APP_USER} LOGIN PASSWORD '${POSTGRES_APP_PASSWORD}' CREATEDB;"
fi

DB_EXISTS=$(psql "$CONNSTRING" -tAc "SELECT 1 FROM pg_database WHERE datname = '${POSTGRES_APP_DB}'")
if [ "$DB_EXISTS" != "1" ]; then
  psql "$CONNSTRING" -v ON_ERROR_STOP=1 -c "CREATE DATABASE ${POSTGRES_APP_DB} OWNER ${POSTGRES_APP_USER};"
fi
