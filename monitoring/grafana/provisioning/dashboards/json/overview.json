{
  "title": "HA Cluster Overview",
  "uid": "haha-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "title": "CPU usage (per node exporter)", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":0,"y":0},
      "targets": [{ "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "{{instance}}" }] },
    { "id": 2, "title": "Memory usage", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":12,"y":0},
      "targets": [{ "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "{{instance}}" }] },
    { "id": 3, "title": "Uptime", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":0,"y":8},
      "targets": [{ "expr": "time() - node_boot_time_seconds", "legendFormat": "{{instance}}" }] },
    { "id": 4, "title": "Network traffic (bytes/s)", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":12,"y":8},
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[1m])", "legendFormat": "rx {{instance}} {{device}}" },
        { "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[1m])", "legendFormat": "tx {{instance}} {{device}}" }
      ] },
    { "id": 5, "title": "Postgres: active queries", "type": "timeseries",
      "gridPos": {"h":8,"w":8,"x":0,"y":16},
      "targets": [{ "expr": "pg_stat_activity_count", "legendFormat": "{{instance}} {{state}}" }] },
    { "id": 6, "title": "MySQL: threads running", "type": "timeseries",
      "gridPos": {"h":8,"w":8,"x":8,"y":16},
      "targets": [{ "expr": "mysql_global_status_threads_running", "legendFormat": "{{instance}}" }] },
    { "id": 7, "title": "Redis: connected clients", "type": "timeseries",
      "gridPos": {"h":8,"w":8,"x":16,"y":16},
      "targets": [{ "expr": "redis_connected_clients", "legendFormat": "{{instance}}" }] },
    { "id": 8, "title": "HAProxy: backend server up/down", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":0,"y":24},
      "targets": [{ "expr": "haproxy_server_status{state=\"UP\"}", "legendFormat": "{{proxy}}/{{server}}" }] },
    { "id": 9, "title": "Postgres replication lag (s)", "type": "timeseries",
      "gridPos": {"h":8,"w":6,"x":12,"y":24},
      "targets": [{ "expr": "pg_replication_lag_seconds", "legendFormat": "{{instance}}" }] },
    { "id": 10, "title": "MySQL replication lag (s)", "type": "timeseries",
      "gridPos": {"h":8,"w":6,"x":18,"y":24},
      "targets": [{ "expr": "mysql_slave_status_seconds_behind_source", "legendFormat": "{{instance}}" }] }
  ]
}
