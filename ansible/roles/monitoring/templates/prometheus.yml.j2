global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: haproxy
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ hostvars[groups['haproxy'][0]]['ansible_host'] }}:{{ haproxy_stats_port }}"]

  - job_name: node
    static_configs:
      - targets:
{% for h in groups['all'] %}
          - "{{ hostvars[h]['ansible_host'] }}:9100"
{% endfor %}

  - job_name: postgres
    static_configs:
      - targets:
{% for h in groups['postgres'] %}
          - "{{ hostvars[h]['ansible_host'] }}:9187"
{% endfor %}

  - job_name: mysql
    static_configs:
      - targets:
{% for h in groups['mysql'] %}
          - "{{ hostvars[h]['ansible_host'] }}:9104"
{% endfor %}

  - job_name: redis
    static_configs:
      - targets:
{% for h in groups['redis'] %}
          - "{{ hostvars[h]['ansible_host'] }}:9121"
{% endfor %}
