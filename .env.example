# Copy to .env and adjust. No real secrets belong in this file or in .env.example.
COMPOSE_PROJECT_NAME=haha

# --- PostgreSQL / Patroni ---
PATRONI_SCOPE=pg-cluster
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_lab_pw
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator_lab_pw
POSTGRES_APP_DB=appdb
POSTGRES_APP_USER=appuser
POSTGRES_APP_PASSWORD=appuser_lab_pw

# --- MySQL ---
MYSQL_ROOT_PASSWORD=mysql_root_lab_pw
MYSQL_REPLICATION_USER=repl
MYSQL_REPLICATION_PASSWORD=repl_lab_pw
MYSQL_APP_DB=appdb
MYSQL_APP_USER=appuser
MYSQL_APP_PASSWORD=appuser_lab_pw

# --- Redis ---
REDIS_PASSWORD=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_lab_pw

# --- Compose profile: unset/full = complete topology, "lite" = CI-sized subset ---
COMPOSE_PROFILES=full

# --- Host port overrides (container-internal ports always match the spec) ---
# App defaults to 8080 (rootless Podman can't bind <1024 without a VM sysctl change).
# macOS AirPlay Receiver also binds 5000/7000 by default; override HOST_PG_WRITE_PORT
# below instead of disabling AirPlay Receiver in System Settings > General > AirDrop.
#HOST_APP_PORT=8080
#HOST_PG_WRITE_PORT=15000
#HOST_PG_READ_PORT=5001
#HOST_MYSQL_WRITE_PORT=3307
#HOST_MYSQL_READ_PORT=3308
#HOST_STATS_PORT=8404
